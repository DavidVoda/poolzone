{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "api:types": "cd .. && .venv/bin/python scripts/dump_openapi.py > frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/lib/api-types.d.ts && rm openapi.json"
  },
  "dependencies": {
