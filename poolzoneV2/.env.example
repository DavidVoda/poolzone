DATABASE_URL=postgresql+psycopg://poolzone:poolzone@localhost:5433/poolzone

# Auth. Leave ENV unset (development) to keep localhost open. In production set
# both: POOLZONE_ENV=production enforces login on every /api route, and
# POOLZONE_SECRET_KEY signs the session cookie (app refuses to boot without it).
# POOLZONE_ENV=production
# POOLZONE_SECRET_KEY=change-me-to-a-long-random-string
